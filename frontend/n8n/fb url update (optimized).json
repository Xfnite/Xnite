        {
            "parameters": {
                "jsCode": "// Fail the run if any update was rejected, so problems show up in the executions list\nconst items = $input.all();\nconst failed = items.filter(i => !(i.json.statusCode >= 200 && i.json.statusCode < 300));\nif (failed.length) {\n  const f = failed[0].json;\n  throw new Error(`${failed.length} of ${items.length} updates failed. First: HTTP ${f.statusCode ?? '-'} ${JSON.stringify(f.body ?? f.error ?? '').slice(0, 300)}`);\n}\n// An empty body means the link changed after it was read, so it was left alone\nconst updated = items.filter(i => Array.isArray(i.json.body) && i.json.body.length > 0).length;\nreturn [{ json: { sent: items.length, updated, unchanged_since_read: items.length - updated } }];\n"
            },
